<?xml version="1.0" encoding="utf-8"?>
<!-- Redesign surface for the TV dialogs: rounded 16dp, the same inset as the Material dialog background. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="16dp" />
        <solid android:color="@color/leanback_surface" />
        <stroke
            android:width="1dp"
            android:color="@color/leanback_border" />
    </shape>
</inset>
