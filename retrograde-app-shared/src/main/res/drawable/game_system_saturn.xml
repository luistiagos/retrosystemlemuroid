<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <!-- Sega Saturn — the ringed planet -->
    <!-- Ring (drawn first so the planet overlaps its front) -->
    <path
        android:strokeColor="#9AA7C7"
        android:strokeWidth="4"
        android:fillColor="#00000000"
        android:pathData="M12,54 a40,11 0 1,0 80,0 a40,11 0 1,0 -80,0 Z" />
    <!-- Planet body -->
    <path
        android:fillColor="#D7A24B"
        android:pathData="M32,50 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 Z" />
    <!-- Planet shading band -->
    <path
        android:fillColor="#B9863A"
        android:pathData="M33,56 a18,18 0 0,0 34,0 Z" />
</vector>
