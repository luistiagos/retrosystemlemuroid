 void FPSSync::reset() {
     lastFrame = MIN_TIME;
+    vsyncWindowStart = MIN_TIME;
+    vsyncWindowFrames = 0;
+}
+
+bool FPSSync::isVSyncTooFast() {
+    auto now = std::chrono::steady_clock::now();
+    if (vsyncWindowStart == MIN_TIME) {
+        vsyncWindowStart = now;
+        vsyncWindowFrames = 0;
+        return false;
+    }
+
+    if (++vsyncWindowFrames < VSYNC_CHECK_FRAMES) return false;
+
+    double elapsed = std::chrono::duration<double>(now - vsyncWindowStart).count();
+    double measuredRate = vsyncWindowFrames / elapsed;
+    vsyncWindowStart = now;
+    vsyncWindowFrames = 0;
+
+    if (measuredRate <= contentRefreshRate * VSYNC_MAX_RATE_RATIO) return false;
+
+    LOGI("Screen is refreshing at %f instead of %f. Switching from vsync to time based sync", measuredRate, screenRefreshRate);
+    return true;
 }
 
